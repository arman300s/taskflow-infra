all:
  vars:
    ansible_user: ubuntu
    ansible_ssh_private_key_file: ${ssh_key}
  children:
%{ for role in ["web", "app", "db"] ~}
    ${role}:
      hosts:
%{ for name, s in servers ~}
%{ if roles[name] == role ~}
        ${name}: { ansible_host: ${s.public_ip}, private_ip: ${s.private_ip}, node_roles: [${join(", ", s.node_roles)}]%{ if s.host_on != null }, host_on: ${s.host_on}%{ endif } }
%{ endif ~}
%{ endfor ~}
%{ endfor ~}
